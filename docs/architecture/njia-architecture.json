  "cards": [
    {
      "dot": "emerald",
      "title": "Two start paths",
      "items": [
        "Free call: book a consultation slot on Get started",
        "Apply now: pay first, paired within 2 days",
        "Both email a set-password link straight away"
      ]
    },
    {
      "dot": "rose",
      "title": "Access control",
      "items": [
        "Proxy refreshes the session and redirects by role",
        "requireViewer re-checks the role from the database",
        "Reads run through asUser so row-level security applies; adminDb only after a server check"
      ]
    },
    {
      "dot": "amber",
      "title": "Payments",
      "items": [
        "A ledger: enrolments, charges, payments",
        "A payment counts only after Paystack's API verifies it",
        "settle() moves each payment out of pending once"
      ]
    },
    {
      "dot": "slate",
      "title": "Not connected yet",
      "items": [
        "Google Calendar code exists but has no credentials, so Meet links are added by hand",
        "Chat assistant stays hidden until GEMINI_* is set"
      ]
    }
