# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_...) or the legacy "service_role" key. Server only.
SUPABASE_SECRET_KEY=

# Supabase → Connect → "Session pooler" connection string (used by Drizzle for migrations)
# postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Where the site runs, for login email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar, for Meet links and call invites. Set the client ID and secret
# (Google Cloud → Credentials → OAuth client, type "Desktop app"), then run
# npm run google:connect to sign in and fill in the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# "primary" is the signed-in account's main calendar
GOOGLE_CALENDAR_ID=primary

# Paystack → Settings → API Keys & Webhooks. Use the test secret key (sk_test_...)
# until launch. Set the webhook URL there to https://<your-site>/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# Resend → API Keys. Sends the weekly parent report. Until a domain is verified,
# leave EMAIL_FROM empty: Resend's test sender only delivers to your own address.
RESEND_API_KEY=
# EMAIL_FROM="Njia <reports@njia.co.ke>"
# Local testing only: deliver every email to this address instead (never set in production)
# EMAIL_REDIRECT_TO=you@example.com

# Any long random string; Vercel Cron sends it to /api/cron/* (set the same value in Vercel)
CRON_SECRET=

# Google AI Studio (aistudio.google.com) → Get API key. Powers the website's chat
# assistant, which stays hidden until both are set. On the free tier Google may use
# what people type to improve its products, so turn on billing before launch.
GEMINI_API_KEY=
# A model ID from ai.google.dev/gemini-api/docs/models; a Flash model is plenty
# GEMINI_MODEL=gemini-3.5-flash
